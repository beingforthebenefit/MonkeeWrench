generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProposalStatus {
  PENDING
  APPROVED
  ARCHIVED
}

enum AuditAction {
  PROPOSE
  VOTE
  UNVOTE
  ADMIN_EDIT
  ADMIN_DELETE
  ADMIN_ARCHIVE
  ADMIN_UNARCHIVE
}

model User {
  id                    String             @id @default(cuid())
  name                  String?
  email                 String?            @unique
  emailVerified         DateTime?
  image                 String?
  // Runs this install: creates bands and connects web addresses to them.
  // Being an admin of a band is per band (Membership.isAdmin).
  isOwner               Boolean            @default(false)
  // What the band calls them ("Ken", "Ed"); shown instead of the full name
  displayName           String?
  // scrypt hash; null = no password yet, so they cannot sign in
  passwordHash          String?
  passwordSetAt         DateTime?
  // Bumped on every password change or reset: older sessions stop working
  sessionVersion        Int                @default(0)
  // Secret in this person's calendar-feed URL (calendar apps can't sign in)
  calendarToken         String?            @unique
  // When their photo was last set; also versions its URL so browsers can
  // cache it forever. Null = no photo (their initial is shown instead).
  avatarAt              DateTime?
  avatar                Avatar?
  accounts              Account[]
  sessions              Session[]
  proposals             Proposal[]         @relation("Proposer")
  votes                 Vote[]
  chartVersions         ChartVersion[]
  songsEdited           Song[]             @relation("SongEditor")
  setlistsEdited        Setlist[]          @relation("SetlistEditor")
  unavailability        Unavailability[]
  // Set the first time someone marks their days, so "hasn't answered" can be
  // told apart from "free every day" (no rows means free)
  availabilityUpdatedAt DateTime?
  // One set of days off for all their bands (the default), or one per band
  shareAvailability     Boolean            @default(true)
  // A rehearsal or gig with one band marks them busy for their other bands
  blockOtherBands       Boolean            @default(true)
  // Finished or skipped the first-time tour (null: show it on sign-in)
  tourDoneAt            DateTime?
  // Emailed links to set a password (sign-up, invites, resets)
  emailTokens           EmailToken[]
  // What their phones are told about (push notifications); each device
  // turns notifications on for itself (PushSubscription)
  notifyCharts          Boolean            @default(true)
  notifySetlists        Boolean            @default(true)
  notifyRehearsals      Boolean            @default(true)
  notifyProposals       Boolean            @default(true)
  pushSubscriptions     PushSubscription[]
  memberships           Membership[]
  cues                  Cue[]
  rehearsalsCreated     Rehearsal[]
  activities            Activity[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
}

// Profile photo: a 256px square JPEG/PNG/WebP, resized in the browser before
// upload. In its own table so loading users never pulls the image bytes.
model Avatar {
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @id
  mime      String
  data      Bytes
  updatedAt DateTime @updatedAt
}

model Proposal {
  id           String         @id @default(cuid())
  band         Band           @relation(fields: [bandId], references: [id], onDelete: Cascade)
  bandId       String
  title        String
  artist       String
  chartUrl     String?
  lyricsUrl    String?
  youtubeUrl   String?
  status       ProposalStatus @default(PENDING)
  proposer     User           @relation("Proposer", fields: [proposerId], references: [id], onDelete: Cascade)
  proposerId   String
  votes        Vote[]
  setlistOrder Int?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([bandId, status])
}

model Vote {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  proposalId String
  createdAt  DateTime @default(now())

  @@unique([userId, proposalId])
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String
  action    AuditAction
  targetId  String?
  createdAt DateTime    @default(now())
}

// NextAuth models
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?
  oauth_token_secret String?
  oauth_token        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// v2: the band's book, charts, setlists and rehearsal availability
// ---------------------------------------------------------------------------

enum SongStatus {
  READY // gig-ready
  LEARNING
}

model Song {
  id          String     @id @default(cuid())
  band        Band       @relation(fields: [bandId], references: [id], onDelete: Cascade)
  bandId      String
  title       String
  writer      String?
  leadSinger  String?
  guitars     Int?
  keys        String? // keyboard parts, e.g. "organ"
  percussion  String?
  youtubeUrl  String?
  lyricsUrl   String?
  status      SongStatus @default(LEARNING)
  // How long the band plays it, for timing sets
  seconds     Int?
  notes       String?    @db.Text
  // Bumped on every chart save so lists can show "edited by X" cheaply
  updatedBy   User?      @relation("SongEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  chartVersions ChartVersion[]
  setlistItems  SetlistItem[]
  cues          Cue[]

  @@index([bandId, title])
}

/// Every chart save is a new row; nothing is updated in place or deleted.
model ChartVersion {
  id           String   @id @default(cuid())
  song         Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  songId       String
  number       Int
  source       String   @db.Text // ChordPro
  note         String?
  author       User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId     String?
  restoredFrom Int?
  createdAt    DateTime @default(now())

  @@unique([songId, number])
}

model Setlist {
  id          String        @id @default(cuid())
  band        Band          @relation(fields: [bandId], references: [id], onDelete: Cascade)
  bandId      String
  name        String
  gigDate     DateTime?
  // When the first set starts, "20:00"; sets and breaks are timed from it
  startTime   String?
  venue       String?
  notes       String?       @db.Text
  items       SetlistItem[]
  updatedBy   User?         @relation("SetlistEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([bandId])
}

enum SetlistItemKind {
  SONG
  SET // starts a set: "Set 1", how long it runs, maybe its own start time
  BREAK // a break between sets, and how long
}

/// One row of a gig's running order: a song, a set header or a break.
model SetlistItem {
  id        String          @id @default(cuid())
  setlist   Setlist         @relation(fields: [setlistId], references: [id], onDelete: Cascade)
  setlistId String
  kind      SetlistItemKind @default(SONG)
  // SONG rows only
  song      Song?           @relation(fields: [songId], references: [id], onDelete: Cascade)
  songId    String?
  // SET: its name ("Set 1", "Encore")
  label     String?
  // SET: planned length; BREAK: how long
  minutes   Int?
  // SET: its own start time ("21:30"), else straight after what's before
  startTime String?
  position  Int
  // Shown above the chart in performance mode ("Micky counts it in")
  note      String?
  // Play this song in a different key for this set
  key       String?

  @@index([setlistId, position])
}

enum UnavailableKind {
  OUT // all day/evening
  PM_OUT // afternoon only
  PREFER_NOT // can make it if needed, would rather another day
}

/// No row means free; a row records that someone can't make it.
model Unavailability {
  id        String          @id @default(cuid())
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  // "" = applies to all their bands (User.shareAvailability), else a band id
  scope     String          @default("")
  date      DateTime        @db.Date
  kind      UnavailableKind
  updatedAt DateTime        @updatedAt

  @@unique([userId, scope, date])
  @@index([date])
}

/// Human-readable record of who changed what, shown in the app.
model Activity {
  id         String   @id @default(cuid())
  // Null for personal changes (password, photo, shared availability), which
  // show in every band the person is in
  band       Band?    @relation(fields: [bandId], references: [id], onDelete: Cascade)
  bandId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId     String?
  action     String // e.g. chart.save, song.update, setlist.update, availability.update
  targetType String
  targetId   String?
  summary    String
  createdAt  DateTime @default(now())

  @@index([targetType, targetId, createdAt])
  @@index([bandId, createdAt])
}

model Rehearsal {
  id          String   @id @default(cuid())
  band        Band     @relation(fields: [bandId], references: [id], onDelete: Cascade)
  bandId      String
  date        DateTime @db.Date
  time        String? // free text, e.g. "7pm"
  place       String?
  note        String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  createdAt   DateTime @default(now())

  @@index([bandId, date])
}

// ---------------------------------------------------------------------------
// Bands: one install serves several. People belong to bands through
// Membership and only ever see the bands they are in.
// ---------------------------------------------------------------------------

model Band {
  id                  String       @id @default(cuid())
  // Used in nothing public; a stable handle for scripts ("monkee-business")
  slug                String       @unique
  name                String // "Monkee Business"
  // What the app is called for this band: header, tab title, home screen
  appName             String       @default("Bandstand")
  // Rehearsal times and "today" are in this zone (IANA name)
  timezone            String       @default("America/Los_Angeles")
  // The band's group chat (Discord, WhatsApp...), linked from the menu
  chatUrl             String?
  // For a tribute band: the act it covers. A proposal with no artist is
  // theirs, and their songs don't get an "Originally by" note.
  tributeTo           String?
  voteThreshold       Int          @default(2)
  // The scheduling tool (availability, suggested days). Off: Rehearsals
  // just lists the rehearsals; the availability API answers 404.
  scheduling          Boolean      @default(true)
  // The hosted service (bandstand.info, BANDSTAND_HOSTED=1): the band can
  // make changes until this; after it, read-only until someone renews.
  // Null: never billed (every self-hosted band; bands the owner comps).
  paidUntil           DateTime?
  // Polar's subscription status, as last reported ("active", "canceled"…)
  subscriptionStatus  String?
  polarCustomerId     String?
  polarSubscriptionId String?      @unique
  // The last checkout started, to find the band if Polar's metadata is lost
  polarCheckoutId     String?
  // Home-screen icon; null = the default Bandstand icon
  iconAt              DateTime?
  icon                BandIcon?
  domains             BandDomain[]
  memberships         Membership[]
  songs               Song[]
  setlists            Setlist[]
  rehearsals          Rehearsal[]
  proposals           Proposal[]
  activities          Activity[]
  createdAt           DateTime     @default(now())
}

/// A 512px square PNG, kept out of Band so loading bands never pulls bytes.
model BandIcon {
  band      Band     @relation(fields: [bandId], references: [id], onDelete: Cascade)
  bandId    String   @id
  mime      String
  data      Bytes
  updatedAt DateTime @updatedAt
}

/// A web address that belongs to a band: its sign-in page, title and
/// home-screen icon are that band's.
model BandDomain {
  host   String @id // lowercase, no port: "members.monkeebusinessband.com"
  band   Band   @relation(fields: [bandId], references: [id], onDelete: Cascade)
  bandId String
}

model Membership {
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  band      Band     @relation(fields: [bandId], references: [id], onDelete: Cascade)
  bandId    String
  // Manages this band: members, passwords, settings, deleting things
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@id([userId, bandId])
  @@index([bandId])
}

// ---------------------------------------------------------------------------
// Personal cues: one person's notes on a chart, seen only by them. Kept out
// of the chart (no version, no history entry) and pinned to the top of the
// song or to a section by its label and occurrence, so they survive other
// people editing the chart.
// ---------------------------------------------------------------------------

enum CueKind {
  TEXT // "count in 2 bars, I start alone"
  IMAGE // a photo or screenshot of a few bars
  ABC // music notation in ABC, drawn on screen and transposed with the chart
}

model Cue {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  song      Song      @relation(fields: [songId], references: [id], onDelete: Cascade)
  songId    String
  // "" = top of the song; else a section: "chorus#2" (label, occurrence)
  anchor    String    @default("")
  position  Int       @default(0)
  kind      CueKind
  // The note (TEXT), the notation (ABC), or a caption (IMAGE)
  text      String?   @db.Text
  image     CueImage?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, songId])
}

/// The picture for an IMAGE cue, out of Cue so listing cues stays light.
model CueImage {
  cue    Cue    @relation(fields: [cueId], references: [id], onDelete: Cascade)
  cueId  String @id
  mime   String
  width  Int
  height Int
  data   Bytes
}

// One device that has notifications on: where to send them (the browser's
// push service) and the keys to encrypt them with. Removed when the push
// service says the device is gone.
model PushSubscription {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  endpoint   String    @unique
  p256dh     String
  auth       String
  // "iPhone", "Android", "Mac": so Account can say which devices are on
  device     String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

// An emailed link that lets someone set their password: the welcome after
// starting a band, an invite from a band's admin, or a reset. Only a hash is
// stored; a link works once, until it expires.
enum EmailTokenKind {
  WELCOME
  INVITE
  RESET
}

model EmailToken {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      EmailTokenKind
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  @@index([userId])
}
