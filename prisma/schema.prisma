generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProposalStatus {
  PENDING
  APPROVED
  ARCHIVED
}

enum AuditAction {
  PROPOSE
  VOTE
  UNVOTE
  ADMIN_EDIT
  ADMIN_DELETE
  ADMIN_ARCHIVE
  ADMIN_UNARCHIVE
}

model User {
  id                    String           @id @default(cuid())
  name                  String?
  email                 String?          @unique
  emailVerified         DateTime?
  image                 String?
  isAdmin               Boolean          @default(false)
  // What the band calls them ("Ken", "Ed"); shown instead of the full name
  displayName           String?
  // scrypt hash; null = no password yet, so they cannot sign in
  passwordHash          String?
  passwordSetAt         DateTime?
  // Bumped on every password change or reset: older sessions stop working
  sessionVersion        Int              @default(0)
  accounts              Account[]
  sessions              Session[]
  proposals             Proposal[]       @relation("Proposer")
  votes                 Vote[]
  chartVersions         ChartVersion[]
  songsEdited           Song[]           @relation("SongEditor")
  setlistsEdited        Setlist[]        @relation("SetlistEditor")
  unavailability        Unavailability[]
  // Set the first time someone marks their days, so "hasn't answered" can be
  // told apart from "free every day" (no rows means free)
  availabilityUpdatedAt DateTime?
  rehearsalsCreated     Rehearsal[]
  activities            Activity[]
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
}

model Proposal {
  id           String         @id @default(cuid())
  title        String
  artist       String
  chartUrl     String?
  lyricsUrl    String?
  youtubeUrl   String?
  status       ProposalStatus @default(PENDING)
  proposer     User           @relation("Proposer", fields: [proposerId], references: [id], onDelete: Cascade)
  proposerId   String
  votes        Vote[]
  setlistOrder Int?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status, setlistOrder])
}

model Vote {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  proposalId String
  createdAt  DateTime @default(now())

  @@unique([userId, proposalId])
}

model Settings {
  id             Int      @id @default(1)
  voteThreshold  Int      @default(2)
  adminAllowlist String[] @db.Text
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String
  action    AuditAction
  targetId  String?
  createdAt DateTime    @default(now())
}

// NextAuth models
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?
  oauth_token_secret String?
  oauth_token        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// v2: the band's book, charts, setlists and rehearsal availability
// ---------------------------------------------------------------------------

enum SongStatus {
  READY // gig-ready
  LEARNING
}

model Song {
  id          String     @id @default(cuid())
  title       String
  writer      String?
  leadSinger  String?
  guitars     Int?
  keys        String? // keyboard parts, e.g. "organ"
  percussion  String?
  youtubeUrl  String?
  lyricsUrl   String?
  status      SongStatus @default(LEARNING)
  notes       String?    @db.Text
  // Bumped on every chart save so lists can show "edited by X" cheaply
  updatedBy   User?      @relation("SongEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  chartVersions ChartVersion[]
  setlistItems  SetlistItem[]

  @@index([title])
}

/// Every chart save is a new row; nothing is updated in place or deleted.
model ChartVersion {
  id           String   @id @default(cuid())
  song         Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  songId       String
  number       Int
  source       String   @db.Text // ChordPro
  note         String?
  author       User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId     String?
  restoredFrom Int?
  createdAt    DateTime @default(now())

  @@unique([songId, number])
}

model Setlist {
  id          String        @id @default(cuid())
  name        String
  gigDate     DateTime?
  venue       String?
  notes       String?       @db.Text
  items       SetlistItem[]
  updatedBy   User?         @relation("SetlistEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model SetlistItem {
  id        String  @id @default(cuid())
  setlist   Setlist @relation(fields: [setlistId], references: [id], onDelete: Cascade)
  setlistId String
  song      Song    @relation(fields: [songId], references: [id], onDelete: Cascade)
  songId    String
  position  Int
  // Shown above the chart in performance mode ("Micky counts it in")
  note      String?
  // Play this song in a different key for this set
  key       String?

  @@index([setlistId, position])
}

enum UnavailableKind {
  OUT // all day/evening
  PM_OUT // afternoon only
  PREFER_NOT // can make it if needed, would rather another day
}

/// No row means free; a row records that someone can't make it.
model Unavailability {
  id        String          @id @default(cuid())
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  date      DateTime        @db.Date
  kind      UnavailableKind
  updatedAt DateTime        @updatedAt

  @@unique([userId, date])
  @@index([date])
}

/// Human-readable record of who changed what, shown in the app.
model Activity {
  id         String   @id @default(cuid())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId     String?
  action     String // e.g. chart.save, song.update, setlist.update, availability.update
  targetType String
  targetId   String?
  summary    String
  createdAt  DateTime @default(now())

  @@index([targetType, targetId, createdAt])
  @@index([createdAt])
}

model Rehearsal {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  time        String? // free text, e.g. "7pm"
  place       String?
  note        String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  createdAt   DateTime @default(now())

  @@index([date])
}
