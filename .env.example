DATABASE_URL=postgresql://monkee:monkee@db:5432/monkee?schema=public
# Public origin for NextAuth (dev default). In prod set to https://members.monkeebusinessband.com
NEXTAUTH_URL=http://localhost:3002
# Internal URL for server->server calls within Docker network (optional but recommended)
INTERNAL_APP_URL=http://app:3000
NEXTAUTH_SECRET=changeme
VOTE_THRESHOLD=2

# Production (docker-compose.server.yml) reads these from .env.production
POSTGRES_PASSWORD=

# Optional: "Sign in with Google" for existing members
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web push (notifications). Generate once:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Email (optional): invites and "Forgot your password?" links. Any SMTP
# service. MAIL_LOG=1 prints messages to the log instead (development).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Bandstand <hello@example.com>
MAIL_LOG=

# The hosted service only (docs/hosting.md): sign-up, trials, Polar billing.
# Leave empty on a self-hosted install. .env.hosted.example has the full set.
BANDSTAND_HOSTED=
