# The hosted service (docker-compose.hosted.yml). Copy to .env.hosted on the
# server and fill in; never commit .env.hosted. docs/hosting.md says where
# each value comes from.

APP_HOST=app.bandstand.info
# For Let's Encrypt's expiry notices
ACME_EMAIL=

# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -base64 32
NEXTAUTH_SECRET=

# SMTP2GO: Sending → SMTP Users
SMTP_HOST=mail.smtp2go.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Bandstand <hello@bandstand.info>

# Polar: Settings → Developers (token), Products (id), Webhooks (secret)
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_ID=
POLAR_WEBHOOK_SECRET=
# "sandbox" while testing with Polar's sandbox; empty for real payments
POLAR_SERVER=

# Push notifications (optional): npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@bandstand.info
